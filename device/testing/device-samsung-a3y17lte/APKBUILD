# Reference: <https://postmarketos.org/devicepkg>
maintainer="Martin Štrobl <recordyletsplays@gmail.com>"
pkgname=device-samsung-a3y17lte
pkgdesc="Samsung Galaxy A3 (2017)"
pkgver=1
pkgrel=2
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	bluez-btmgmt
	linux-firmware-ath10k
	linux-firmware-qca
	linux-samsung-a3y17lte
	mesa-dri-gallium
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	unudhcpd.conf
	90-device-samsung-a3y17lte.rules
	10-a3y17lte-wlan.link
	a3y17lte-bt-addr.sh
	a3y17lte-bt-addr.service
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/unudhcpd.conf "$pkgdir"/etc/unudhcpd.conf

	# Provisional Wi-Fi/BT addresses, see the files
	install -Dm644 "$srcdir"/10-a3y17lte-wlan.link \
		"$pkgdir"/usr/lib/systemd/network/10-a3y17lte-wlan.link
	install -Dm755 "$srcdir"/a3y17lte-bt-addr.sh \
		"$pkgdir"/usr/libexec/a3y17lte-bt-addr
	install -Dm644 "$srcdir"/a3y17lte-bt-addr.service \
		"$pkgdir"/usr/lib/systemd/system/a3y17lte-bt-addr.service
}

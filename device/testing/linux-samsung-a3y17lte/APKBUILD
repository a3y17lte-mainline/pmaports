# Kernel config based on linux-postmarketos-exynos7870
maintainer="Martin Štrobl <recordyletsplays@gmail.com>"
pkgname=linux-samsung-a3y17lte
pkgver=7.4_rc2
pkgrel=3
pkgdesc="Close-to-mainline kernel for the Samsung Galaxy A3 (2017)"
arch="aarch64"
_carch="arm64"
_flavor="samsung-a3y17lte"
url="https://github.com/a3y17lte-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bc
	bison
	clang
	elfutils-dev
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

_commit="7604138f4c4736c5666b81ce15f1ea90c969a2f6"
_config="config-$_flavor.aarch64"

# Source
source="
	linux-$_commit.tar.gz::https://github.com/a3y17lte-mainline/linux/archive/$_commit.tar.gz
	$_config
"
builddir="$srcdir/linux-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	# pmbootstrap exports a GCC cross CC; the tools build (resolve_btfids)
	# would use it. LLVM=1 selects clang for everything. pmbootstrap's
	# ccache only wraps the GCC cross compilers, so wrap clang here: the
	# build directory is the same every time, so unchanged files hit.
	unset CC
	make ARCH="$_carch" LLVM=1 HOSTLDFLAGS="-fuse-ld=lld" \
		CC="ccache clang" HOSTCC="ccache clang" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	unset CC

	# The bootloader does not support zipped kernels
	make install dtbs_install modules_install \
		ARCH="$_carch" \
		LLVM=1 CC="ccache clang" HOSTCC="ccache clang" \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release

	install -Dm644 "$builddir"/arch/"$_carch"/boot/Image \
		"$pkgdir"/boot/vmlinuz
}
sha512sums="

From 083f20a2c0e9b6969504518bb0b480da2d4e6368 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20=C5=A0trobl?= <recordyletsplays@gmail.com>
Date: Wed, 11 Nov 2026 01:01:52 +0100
Subject: [PATCH 4/6] pan/mdg: Rematerialize varyings instead of spilling them

When a fragment shader runs out of work registers, a value loaded by a
varying load is spilled like any other: stored to thread-local storage
after the load and filled from it before each use. The load itself has
no register sources and can simply be repeated instead, which needs no
store, no scratch memory and no fill.

When the spill candidate is written once by such a load, insert a copy
of the load before each bundle that uses the value, rewrite the uses to
the copies and remove the original load.

shader-db (T830, same on T820): fills 693 -> 399, spills 80 -> 62;
4 shaders change, 3 shrink by up to 11 bundles and one grows from 446 to
462 bundles. T860: fills 612 -> 330. T720 has no spilling shaders.
---
 src/panfrost/compiler/midgard/midgard_ra.c | 123 +++++++++++++++++++++
 1 file changed, 123 insertions(+)

diff --git a/src/panfrost/compiler/midgard/midgard_ra.c b/src/panfrost/compiler/midgard/midgard_ra.c
index 5f53b8d44..b01087759 100644
--- a/src/panfrost/compiler/midgard/midgard_ra.c
+++ b/src/panfrost/compiler/midgard/midgard_ra.c
@@ -1234,6 +1234,121 @@ mir_choose_spill_node(compiler_context *ctx, struct lcra_state *l)
 
 /* Once we've chosen a spill node, spill it */
 
+/* A value written once by a varying load without register sources can be
+ * loaded again right before each use instead of going through TLS: that
+ * needs no spill store and no scratch memory. Returns the load, or NULL. */
+
+static midgard_instruction *
+mir_rematerializable_def(compiler_context *ctx, unsigned node)
+{
+   midgard_instruction *def = NULL;
+
+   if (ctx->stage != MESA_SHADER_FRAGMENT)
+      return NULL;
+
+   mir_foreach_instr_global(ctx, ins) {
+      if (ins->dest != node)
+         continue;
+      if (def)
+         return NULL;
+      def = ins;
+   }
+
+   if (!def || def->type != TAG_LOAD_STORE_4 || def->compact_branch)
+      return NULL;
+
+   switch (def->op) {
+   case midgard_op_ld_vary_32:
+   case midgard_op_ld_vary_16:
+   case midgard_op_ld_vary_32u:
+   case midgard_op_ld_vary_32i:
+      break;
+   default:
+      return NULL;
+   }
+
+   mir_foreach_src(def, s) {
+      if (def->src[s] != ~0)
+         return NULL;
+   }
+
+   /* A use in the bundle of the load itself would need the value in the
+    * pipeline already */
+   mir_foreach_instr_global(ctx, ins) {
+      if (ins != def && ins->bundle_id == def->bundle_id &&
+          mir_has_arg(ins, node))
+         return NULL;
+   }
+
+   return def;
+}
+
+static void
+mir_rematerialize(compiler_context *ctx, midgard_instruction *def,
+                  unsigned node)
+{
+   unsigned index = ctx->temp_count;
+   midgard_block *last_block = NULL;
+   unsigned last_bundle = ~0;
+   unsigned last_index = ~0;
+
+   midgard_instruction copy = *def;
+   copy.no_spill |= (1 << REG_CLASS_WORK);
+
+   mir_foreach_block(ctx, _block) {
+      midgard_block *block = (midgard_block *)_block;
+      mir_foreach_instr_in_block(block, ins) {
+         if (ins == def || !mir_has_arg(ins, node))
+            continue;
+
+         /* One load per bundle is enough for every use in it */
+         if (block != last_block || ins->bundle_id != last_bundle) {
+            copy.dest = ++index;
+            mir_insert_instruction_before_scheduled(ctx, block, ins, &copy);
+            last_block = block;
+            last_bundle = ins->bundle_id;
+            last_index = copy.dest;
+         }
+
+         mir_rewrite_index_src_single(ins, node, last_index);
+      }
+   }
+
+   /* The original load has no uses left: remove it from its bundle (dropping
+    * the bundle if it is now empty) and from the program. */
+   mir_foreach_block(ctx, _block) {
+      midgard_block *block = (midgard_block *)_block;
+      midgard_bundle *bundles = (midgard_bundle *)block->bundles.data;
+      unsigned count = util_dynarray_num_elements(&block->bundles, midgard_bundle);
+
+      for (unsigned i = 0; i < count; ++i) {
+         midgard_bundle *bundle = &bundles[i];
+
+         for (unsigned j = 0; j < bundle->instruction_count; ++j) {
+            if (bundle->instructions[j] != def)
+               continue;
+
+            if (bundle->instruction_count == 1) {
+               block->quadword_count -= midgard_tag_props[bundle->tag].size;
+               memmove(bundle, bundle + 1,
+                       (count - i - 1) * sizeof(midgard_bundle));
+               block->bundles.size -= sizeof(midgard_bundle);
+            } else {
+               memmove(&bundle->instructions[j], &bundle->instructions[j + 1],
+                       (bundle->instruction_count - j - 1) *
+                          sizeof(bundle->instructions[0]));
+               bundle->instruction_count--;
+            }
+
+            mir_remove_instruction(def);
+            return;
+         }
+      }
+   }
+
+   UNREACHABLE("Rematerialized load not scheduled");
+}
+
 static void
 mir_spill_register(compiler_context *ctx, unsigned spill_node,
                    unsigned spill_class, unsigned *spill_count)
@@ -1243,6 +1358,14 @@ mir_spill_register(compiler_context *ctx, unsigned spill_node,
 
    unsigned spill_index = ctx->temp_count;
 
+   if (spill_class == REG_CLASS_WORK) {
+      midgard_instruction *def = mir_rematerializable_def(ctx, spill_node);
+      if (def) {
+         mir_rematerialize(ctx, def, spill_node);
+         return;
+      }
+   }
+
    /* We have a spill node, so check the class. Work registers
     * legitimately spill to TLS, but special registers just spill to work
     * registers */
-- 

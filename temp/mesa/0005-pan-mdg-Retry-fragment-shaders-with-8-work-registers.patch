From e093f606746457cc7e2595ddf9a24094d18044c5 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20=C5=A0trobl?= <recordyletsplays@gmail.com>
Date: Wed, 11 Nov 2026 01:02:09 +0100
Subject: [PATCH 5/6] pan/mdg: Retry fragment shaders with 8 work registers

Midgard keeps twice as many threads in flight when a shader uses at
most 8 work registers instead of 16, and four times as many at 4. A
fragment shader that needs more than 8 registers therefore runs at the
lowest thread count, even when spilling a few values would let it run
at twice the threads and hide more of the memory latency.

Compile fragment shaders that end up with more than 8 work registers a
second time with the allocator limited to 8, and keep the result that is
expected to be faster: bundles weighted by the measured relative cost
per bundle at each thread count. The second attempt may fail to
allocate; then the first result is used. MIDGARD_MESA_DEBUG=noregretry
disables the retry.

Mali-T830, full-window GTK gradient: 67 ms -> 55 ms per frame.
shader-db: 349 fragment shaders switch to 8 registers on T830 and T820,
335 on T860, 68 on T720; no compile failures. Their bundle counts grow
(T830: +11.5% over all shaders): the extra spill code is accepted where
the doubled thread count is expected to make up for it.
---
 src/panfrost/compiler/midgard/compiler.h      |  6 +-
 src/panfrost/compiler/midgard/midgard.h       |  1 +
 .../compiler/midgard/midgard_compile.c        | 89 ++++++++++++++++---
 src/panfrost/compiler/midgard/midgard_ra.c    | 23 ++++-
 4 files changed, 101 insertions(+), 18 deletions(-)

diff --git a/src/panfrost/compiler/midgard/compiler.h b/src/panfrost/compiler/midgard/compiler.h
index 475787367..974fdd88a 100644
--- a/src/panfrost/compiler/midgard/compiler.h
+++ b/src/panfrost/compiler/midgard/compiler.h
@@ -259,6 +259,10 @@ typedef struct compiler_context {
    unsigned spills;
    unsigned fills;
 
+   /* Upper bound on work registers for this compile, see
+    * midgard_compile_shader_nir() */
+   unsigned max_work;
+
    /* Current NIR function */
    nir_function *func;
 
@@ -677,7 +681,7 @@ mir_has_arg(const midgard_instruction *ins, unsigned arg)
 
 void midgard_schedule_program(compiler_context *ctx);
 
-void mir_ra(compiler_context *ctx);
+bool mir_ra(compiler_context *ctx);
 void mir_squeeze_index(compiler_context *ctx);
 void mir_lower_special_reads(compiler_context *ctx);
 void mir_liveness_ins_update(uint16_t *live, const midgard_instruction *ins,
diff --git a/src/panfrost/compiler/midgard/midgard.h b/src/panfrost/compiler/midgard/midgard.h
index 79ce024a2..077dcfcd6 100644
--- a/src/panfrost/compiler/midgard/midgard.h
+++ b/src/panfrost/compiler/midgard/midgard.h
@@ -16,6 +16,7 @@
 #define MIDGARD_DBG_INORDER  0x0008
 #define MIDGARD_DBG_VERBOSE  0x0010
 #define MIDGARD_DBG_INTERNAL 0x0020
+#define MIDGARD_DBG_NO_REG_RETRY 0x0040
 
 extern int midgard_debug;
 
diff --git a/src/panfrost/compiler/midgard/midgard_compile.c b/src/panfrost/compiler/midgard/midgard_compile.c
index 06eeeebd6..9d3ed5912 100644
--- a/src/panfrost/compiler/midgard/midgard_compile.c
+++ b/src/panfrost/compiler/midgard/midgard_compile.c
@@ -42,6 +42,7 @@ static const struct debug_named_value midgard_debug_options[] = {
    {"inorder", MIDGARD_DBG_INORDER, "Disables out-of-order scheduling"},
    {"verbose", MIDGARD_DBG_VERBOSE, "Dump shaders verbosely"},
    {"internal", MIDGARD_DBG_INTERNAL, "Dump internal shaders"},
+   {"noregretry", MIDGARD_DBG_NO_REG_RETRY, "Do not retry fragment shaders with 8 work registers"},
    DEBUG_NAMED_VALUE_END};
 
 DEBUG_GET_ONCE_FLAGS_OPTION(midgard_debug, "MIDGARD_MESA_DEBUG",
@@ -2947,16 +2948,16 @@ mir_add_writeout_loops(compiler_context *ctx)
    }
 }
 
-void
-midgard_compile_shader_nir(nir_shader *nir,
-                           const struct pan_compile_inputs *inputs,
-                           struct util_dynarray *binary,
-                           struct pan_shader_info *info)
+static bool
+midgard_compile_shader_nir_impl(nir_shader *nir,
+                                const struct pan_compile_inputs *inputs,
+                                struct util_dynarray *binary,
+                                struct pan_shader_info *info,
+                                unsigned max_work)
 {
-   midgard_debug = debug_get_option_midgard_debug();
-
    /* TODO: Bound against what? */
    compiler_context *ctx = rzalloc(NULL, compiler_context);
+   ctx->max_work = max_work;
 
    ctx->inputs = inputs;
    ctx->nir = nir;
@@ -3064,7 +3065,11 @@ midgard_compile_shader_nir(nir_shader *nir,
 
    /* Schedule! */
    midgard_schedule_program(ctx);
-   mir_ra(ctx);
+   if (!mir_ra(ctx)) {
+      _mesa_hash_table_u64_destroy(ctx->ssa_constants);
+      ralloc_free(ctx);
+      return false;
+   }
 
    if (midgard_debug & MIDGARD_DBG_SHADERS && !skip_internal)
       mir_print_shader(ctx);
@@ -3160,11 +3165,69 @@ midgard_compile_shader_nir(nir_shader *nir,
    info->stats.isa = PAN_STAT_MIDGARD;
    info->stats.midgard = stats;
 
-   if ((midgard_debug & MIDGARD_DBG_SHADERDB) && !nir->info.internal) {
-      const char *prefix = _mesa_shader_stage_to_abbrev(ctx->stage);
-      midgard_stats_fprintf(stderr, prefix, &stats);
-   }
-
    _mesa_hash_table_u64_destroy(ctx->ssa_constants);
    ralloc_free(ctx);
+   return true;
+}
+
+/* Relative time per bundle at a given thread count. A shader core keeps more
+ * threads in flight when each uses fewer work registers (up to 4: 4x, up to
+ * 8: 2x), which hides more latency. Measured on Mali-T830 with GTK gradient
+ * shaders: at 2x the threads each bundle took 0.47x to 0.55x the time. The
+ * 4x value is an extrapolation. */
+static unsigned
+mir_bundle_cost(const struct midgard_stats *stats)
+{
+   static const unsigned cost_per_bundle[] = {[1] = 100, [2] = 55, [4] = 35};
+
+   return stats->bundles * cost_per_bundle[stats->threads];
+}
+
+void
+midgard_compile_shader_nir(nir_shader *nir,
+                           const struct pan_compile_inputs *inputs,
+                           struct util_dynarray *binary,
+                           struct pan_shader_info *info)
+{
+   midgard_debug = debug_get_option_midgard_debug();
+
+   /* Fragment shaders that need more than 8 work registers run at the lowest
+    * thread count. Compile them again limited to 8 and keep whichever is
+    * expected to run faster: the extra spill code is often cheaper than the
+    * lost latency hiding. */
+   bool try_fewer_registers = nir->info.stage == MESA_SHADER_FRAGMENT &&
+                              !inputs->is_blend &&
+                              !(midgard_debug & MIDGARD_DBG_NO_REG_RETRY);
+
+   nir_shader *retry_nir =
+      try_fewer_registers ? nir_shader_clone(NULL, nir) : NULL;
+   struct pan_shader_info retry_info = *info;
+   unsigned binary_start = binary->size;
+
+   midgard_compile_shader_nir_impl(nir, inputs, binary, info, 16);
+
+   if (retry_nir && info->work_reg_count > 8) {
+      struct util_dynarray retry_binary;
+      util_dynarray_init(&retry_binary, NULL);
+
+      bool ok = midgard_compile_shader_nir_impl(retry_nir, inputs,
+                                                &retry_binary, &retry_info, 8);
+
+      if (ok && mir_bundle_cost(&retry_info.stats.midgard) <
+                   mir_bundle_cost(&info->stats.midgard)) {
+         binary->size = binary_start;
+         util_dynarray_append_array(binary, uint8_t, retry_binary.data,
+                                    retry_binary.size);
+         *info = retry_info;
+      }
+
+      util_dynarray_fini(&retry_binary);
+   }
+
+   ralloc_free(retry_nir);
+
+   if ((midgard_debug & MIDGARD_DBG_SHADERDB) && !nir->info.internal) {
+      const char *prefix = _mesa_shader_stage_to_abbrev(nir->info.stage);
+      midgard_stats_fprintf(stderr, prefix, &info->stats.midgard);
+   }
 }
diff --git a/src/panfrost/compiler/midgard/midgard_ra.c b/src/panfrost/compiler/midgard/midgard_ra.c
index b01087759..d863ce249 100644
--- a/src/panfrost/compiler/midgard/midgard_ra.c
+++ b/src/panfrost/compiler/midgard/midgard_ra.c
@@ -762,6 +762,8 @@ max_work_registers(const compiler_context *ctx)
    unsigned rmu_vec4 = ctx->info->fau.count / 4;
    unsigned max_work_registers = (rmu_vec4 >= 8) ? (24 - rmu_vec4) : 16;
 
+   max_work_registers = MIN2(max_work_registers, ctx->max_work);
+
    if (needs_contiguous_workgroup(ctx)) {
       unsigned threads = max_threads_per_workgroup(ctx);
       assert(threads <= 128 && "maximum threads in ABI exceeded");
@@ -1621,12 +1623,17 @@ mir_demote_uniforms(compiler_context *ctx, unsigned new_cutoff)
 
 /* Run register allocation in a loop, spilling until we succeed */
 
-void
+bool
 mir_ra(compiler_context *ctx)
 {
    struct lcra_state *l = NULL;
    bool spilled = false;
-   int iter_count = 1000; /* max iterations */
+
+   /* A compile with a lowered register limit is only an attempt (see
+    * midgard_compile_shader_nir): give up early and quietly, the caller keeps
+    * the full-limit result. */
+   bool attempt = ctx->max_work < 16;
+   int iter_count = attempt ? 100 : 1000; /* max iterations */
 
    /* Number of 128-bit slots in memory we've spilled into */
    unsigned spill_count = DIV_ROUND_UP(ctx->info->tls_size, 16);
@@ -1643,9 +1650,11 @@ mir_ra(compiler_context *ctx)
          if (l->spill_class == REG_CLASS_WORK && uniforms > 8) {
             mir_demote_uniforms(ctx, MAX2(uniforms - 4, 8));
          } else if (spill_node == -1) {
-            fprintf(stderr, "ERROR: Failed to choose spill node\n");
             lcra_free(l);
-            return;
+            if (attempt)
+               return false;
+            fprintf(stderr, "ERROR: Failed to choose spill node\n");
+            return true;
          } else {
             mir_spill_register(ctx, spill_node, l->spill_class, &spill_count);
          }
@@ -1660,6 +1669,11 @@ mir_ra(compiler_context *ctx)
       l = allocate_registers(ctx, &spilled);
    } while (spilled && ((iter_count--) > 0));
 
+   if (iter_count <= 0 && attempt) {
+      lcra_free(l);
+      return false;
+   }
+
    if (iter_count <= 0) {
       fprintf(
          stderr,
@@ -1675,4 +1689,5 @@ mir_ra(compiler_context *ctx)
    install_registers(ctx, l);
 
    lcra_free(l);
+   return true;
 }
